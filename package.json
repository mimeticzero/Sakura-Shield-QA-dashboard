{
  "name": "sakura-shield",
  "version": "1.0.0",
  "private": true,
  "description": "Industrial QA & Automation Suite — Sakura Ecosystem",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config tests/e2e/playwright.config.ts --headed",
    "test:visual": "percy exec -- playwright test --config tests/e2e/playwright.config.ts --project=visual",
    "test:lighthouse": "node tests/load/lighthouse-all.js",
    "test:load": "k6 run tests/load/k6-sakura-node.js",
    "test:load:smoke": "k6 run tests/load/k6-smoke.js",
    "test:load:stress": "k6 run tests/load/k6-stress.js",
    "test:security": "node tests/security/zap-runner.js",
    "test:all": "npm run test:e2e && npm run test:load && npm run test:security",
    "report:html": "playwright show-report playwright-report",
    "report:open": "npx serve playwright-report"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "framer-motion": "^11.3.0",
    "@vercel/analytics": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@percy/cli": "^1.29.0",
    "@percy/playwright": "^1.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "lighthouse": "^12.2.0",
    "chrome-launcher": "^1.1.0",
    "@lhci/cli": "^0.14.0",
    "axe-playwright": "^2.0.1",
    "dotenv": "^16.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
